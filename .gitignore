# Byte-compiled / optimized files
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Packaging / build artefacts
build/
dist/
*.egg-info/
.eggs/

# Test & tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Local secrets and scratch files — never commit these
.env
.env.*
!.env.example
*.pem
*.key
secrets*.txt
secrets*.json
/scratch/
*.log
!examples/**/*.log
